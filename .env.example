# Скопируйте в .env и заполните значения
PRODUCT=Скамейки
REGION=Дагестан
REGION_SLUG=dagestan
LOCATION_ID=646710

REPORT_INTERVAL_DAYS=3
MAX_PAGES=50
REQUEST_DELAY_SECONDS=2.0

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=your@gmail.com
# Для Gmail: пароль приложения (16 символов), НЕ обычный пароль аккаунта
# https://myaccount.google.com/apppasswords
SMTP_PASSWORD=abcdefghijklmnop
SMTP_FROM=your@gmail.com
SMTP_TO=recipient@example.com

# Опционально: HTTP/SOCKS прокси с российским IP (рекомендуется для Авито)
# PROXY=http://user:pass@host:port

# Демо-режим: использовать тестовые данные вместо реального сканирования
# DEMO_MODE=false

# Использовать браузер Playwright (рекомендуется для Авито)
USE_BROWSER=true

# Только браузер, без HTTP/API (быстрее при блокировке 429)
# BROWSER_ONLY=true

# Скрытый режим браузера (false = видимое окно, удобно для капчи)
# BROWSER_HEADLESS=false

# Профиль браузера (сохраняет cookies между запусками)
# BROWSER_PROFILE_DIR=data/browser_profile

# Создавать PDF-отчёт (report.pdf) и отправлять его на email
EXPORT_PDF=true

# Сколько страниц подряд без новых объявлений ждать перед остановкой
BROWSER_MAX_EMPTY_PAGES=3

# Сколько секунд ждать прохождения капчи в видимом браузере
BROWSER_CAPTCHA_WAIT_SECONDS=180

# Скрытый режим (false = видимое окно, рекомендуется при блокировках)
# BROWSER_HEADLESS=false

# Пауза при блокировке 429 от Авито (секунды)
RATE_LIMIT_BACKOFF_SECONDS=15
